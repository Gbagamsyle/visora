{
  "name": "visora",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @visora/web dev",
    "dev:web": "pnpm --filter @visora/web dev",
    "dev:admin": "pnpm --filter @visora/admin dev",
    "dev:api": "pnpm --filter @visora/api dev",
    "dev:all": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --recursive --filter ./apps/* build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
